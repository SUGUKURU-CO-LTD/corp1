# スグクル コーポレートサイト 環境変数サンプル
# Sugukuru corporate site environment variables (example)
# Contoh variabel lingkungan situs korporat Sugukuru
#
# 値は空のままコミットすること（実値は .env / Secret Manager で管理）。
# Commit with empty values (real values live in .env / Secret Manager).
# Commit dengan nilai kosong (nilai asli ada di .env / Secret Manager).

# GA4 測定ID（Google Analytics 4 Measurement ID）
#
# 機密情報ではありません（クライアント側に露出する公開IDです）。
# Next.jsの NEXT_PUBLIC_* 環境変数はビルド時に値が固定されます
# （実行時に切り替えることはできません）。そのため、Preview環境と
# Production環境で値を変えたい場合は、環境ごとに別ビルド（別イメージ）
# を作成する必要があります。
#
# 未設定のままビルドした場合、GA4関連のスクリプト・タグ・測定ID文字列は
# 一切出力されません（src/app/layout.tsx 参照）。
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# チーム限定エリア（/team・/api/team）の IAP 検証用 Audience
# IAP audience for the team-only area
IAP_AUDIENCE=

# AgriOps ライブ取得プロキシ（未設定なら同梱スナップショットを返す）
# AgriOps live proxy URL (falls back to bundled snapshot if empty)
AGRIOPS_PROXY_URL=

# 上記プロキシへの Bearer トークン（Secret Manager 推奨）
# Bearer token for the proxy above (use Secret Manager)
AGRIOPS_PROXY_TOKEN=

# ローカル開発のみ: IAP を迂回（本番では絶対に設定しない）
# Local dev only: bypass IAP (never set in production)
TEAM_DEV_BYPASS=
